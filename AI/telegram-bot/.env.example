# Скопируйте в .env для локального запуска или воспользуйтесь start-скриптом.
# Для облака deploy-скрипт создаёт отдельный .env.cloud.
# Никогда не публикуйте настоящий токен или пароль в Git.

# Токен бота от @BotFather (обязательно).
BOT_TOKEN=
# Локально можно оставить пустым; в облаке прокси обязателен.
# Примеры: http://user:password@proxy.example:3128 или socks5://proxy.example:1080
# Символы @, :, / в логине/пароле кодируйте как %40, %3A, %2F.
TELEGRAM_PROXY_URL=

# Локально: 127.0.0.1 и опубликованный порт. В облаке: db и 5432.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=bot
POSTGRES_USER=bot
# Скрипт сгенерирует пароль, если поле пустое. После создания БД не меняйте его
# только в env-файле: пароль роли PostgreSQL хранится внутри самой БД.
POSTGRES_PASSWORD=

LOG_LEVEL=INFO
# Служебный HTTP-порт на 127.0.0.1; наружу в облаке не публикуется.
HEALTH_PORT=8080

# Бесплатный план Groq. Ключ — секрет, в Git его не кладут. Карту к аккаунту не привязывайте.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_SECONDS=30
# Хвост диалога. 4000 символов оставляют место инструкции и ответу в лимите Groq
# 8000 токенов в минуту.
HISTORY_MAX_MESSAGES=10
HISTORY_MAX_CHARS=4000

# Лабораторная № 2: расписание, MCP и погода.
SCHEDULE_PATH=data/schedule.json
DEFAULT_APP_TIMEZONE=Europe/Moscow
WEATHER_HTTP_TIMEOUT_SECONDS=10
# Пусто — python -m mcp_server из того же интерпретатора.
MCP_SERVER_COMMAND=
# Секрет доверия для add_reminder. Пусто — производная от BOT_TOKEN.
MCP_TRUST_TOKEN=
MAX_MCP_CALLS_PER_MESSAGE=2
